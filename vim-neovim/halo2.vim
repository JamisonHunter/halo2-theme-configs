" Halo 2 main menu: dark navy and steel-blue
set background=dark
hi clear
if exists('syntax_on') | syntax reset | endif
let g:colors_name = 'halo2'

function! s:hi(group, fg, bg, attr) abort
  exe 'hi ' . a:group . ' guifg=' . a:fg . ' guibg=' . a:bg . ' gui=' . a:attr . ' cterm=' . a:attr
endfunction

